---
/**
 * Site header, Aero-style: a full-width bar with the nav right after the logo and buttons on
 * the right. A dropdown expands the header into a full-width sheet: the group name and a line of
 * intro, the links (icon tile, label, one-line description) in two columns, and one featured
 * card. The page behind dims. All content comes from config/site.ts (navGroups, navLinks,
 * headerActions).
 *
 * Desktop (lg+): dropdowns open on hover (fine pointers) or click; close on Escape, outside
 * click, or when focus leaves. Mobile: a menu button opens a grouped list of every link.
 */
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import Logo from "../ui/Logo.astro";
import Button from "../ui/Button.astro";
import AppIcon from "../ui/AppIcon.astro";
import PostCover from "../ui/PostCover.astro";
import { navGroups, navLinks, headerActions, type NavLink } from "../../config/site";
import { heroApps } from "../../data/ecosystem";
import dashboardStaking from "../../assets/screens/dashboard-staking.png";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
const ext = (href: string) =>
  href.startsWith("http") ? { target: "_blank", rel: "noopener noreferrer" } : {};
const menuApps = heroApps.slice(0, 18);
const linkAttrs = (l: NavLink) => ext(l.href);
---

<!-- Marks the top of the page: while it is visible the bar has no background or bottom line -->
<div
  class="pointer-events-none absolute top-0 left-0 h-px w-px"
  data-top-sentinel
  aria-hidden="true"
></div>

<header class="sticky top-0 z-40" data-header>
  <a
    href="#main"
    class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-4 focus:z-50 focus:rounded-pill focus:bg-accent focus:px-4 focus:py-2 focus:text-on-accent"
  >
    Skip to content
  </a>

  <!-- Dims and blurs the page while a dropdown is open -->
  <div
    class="menu-scrim pointer-events-none fixed inset-0 top-16 bg-ink/60"
    data-menu-scrim
    aria-hidden="true"
  ></div>

  <div
    class="relative border-b border-transparent transition-colors duration-300 data-[open]:bg-surface data-[scrolled]:border-line data-[scrolled]:bg-ink/85 data-[scrolled]:backdrop-blur-xl data-[scrolled]:data-[open]:bg-surface"
    data-header-bar
  >
    <!-- One shared sheet behind every dropdown. Its height follows the open panel, so moving
         between dropdowns resizes it smoothly instead of closing one and opening the next. -->
    <div
      class="menu-backdrop pointer-events-none absolute inset-x-0 top-full hidden rounded-b-3xl border-b border-line bg-surface shadow-[0_30px_60px_-30px_rgb(0_0_0/0.8)] lg:block"
      data-menu-backdrop
      aria-hidden="true"
    ></div>
    <div class="flex h-16 items-center gap-8 px-4 md:px-6">
      <a href="/" class="shrink-0 text-fg" aria-label="Secret Network home">
        <Logo class="h-6 w-auto md:h-[1.6rem]" />
      </a>

      <!-- Desktop navigation, right after the logo -->
      <nav aria-label="Main" class="hidden lg:block">
        <ul class="flex items-center gap-1">
          {navGroups.map((group, gi) => {
            const active =
              group.links.some((l) => isActive(l.href)) || isActive(group.featured.href);
            return (
              <li data-menu-item>
                <button
                  type="button"
                  class:list={[
                    "group/trig inline-flex h-9 items-center gap-1.5 rounded-pill px-3.5 text-sm transition-colors hover:text-fg aria-expanded:bg-surface-3 aria-expanded:text-fg",
                    active ? "text-fg" : "text-muted",
                  ]}
                  aria-expanded="false"
                  aria-controls={`menu-${gi}`}
                  data-menu-trigger
                >
                  {group.label}
                  <Icon
                    name="ph:caret-down-fill"
                    class="size-2.5 transition-transform duration-300 group-aria-expanded/trig:rotate-180"
                    aria-hidden="true"
                  />
                </button>

                <!-- Full-width sheet: group intro · links with icon tiles · one featured card -->
                <div
                  id={`menu-${gi}`}
                  class="menu-panel absolute inset-x-0 top-full"
                  data-menu-panel
                >
                  <div class="grid grid-cols-[34rem_minmax(0,1fr)] gap-10 px-4 py-8 md:px-6 xl:grid-cols-[14rem_36rem_minmax(0,1fr)] xl:gap-12">
                    <div class="hidden xl:block">
                      <p class="text-sm font-medium text-fg">{group.label}</p>
                      <p class="mt-2 text-sm leading-relaxed text-faint">{group.intro}</p>
                    </div>

                    <ul class="grid grid-cols-2 content-start gap-x-6 gap-y-1">
                      {group.links.map((link) => (
                        <li>
                          <a
                            href={link.href}
                            {...linkAttrs(link)}
                            aria-current={isActive(link.href) ? "page" : undefined}
                            class="group/link flex items-start gap-3.5 rounded-lg p-3 transition-colors hover:bg-surface-2 aria-[current=page]:bg-surface-2"
                          >
                            <span class="inline-flex size-9 shrink-0 items-center justify-center rounded-md border border-line bg-ink text-muted transition-colors group-hover/link:text-fg">
                              <Icon name={link.icon} class="size-[1.125rem]" aria-hidden="true" />
                            </span>
                            <span class="min-w-0">
                              <span class="flex items-center gap-1 text-[0.9375rem] font-medium text-fg">
                                {link.label}
                                {link.external && (
                                  <Icon
                                    name="ph:arrow-up-right"
                                    class="size-3.5 text-faint"
                                    aria-hidden="true"
                                  />
                                )}
                              </span>
                              <span class="mt-0.5 block text-sm leading-snug text-faint">
                                {link.description}
                              </span>
                            </span>
                          </a>
                        </li>
                      ))}
                    </ul>

                    <a
                      href={group.featured.href}
                      {...ext(group.featured.href)}
                      class="group/card w-[19rem] self-start justify-self-end overflow-hidden rounded-xl border border-line bg-ink transition-colors hover:border-line-strong"
                    >
                      <div
                        class="relative h-36 overflow-hidden border-b border-line"
                        aria-hidden="true"
                      >
                        {group.featured.visual === "dashboard" && (
                          <Image
                            src={dashboardStaking}
                            alt=""
                            widths={[400, 600]}
                            sizes="304px"
                            class="size-full object-cover object-left-top transition-transform duration-700 ease-out-expo group-hover/card:scale-[1.03]"
                          />
                        )}
                        {group.featured.visual === "apps" && (
                          <div class="grid size-full grid-cols-6 content-center gap-2 bg-surface-2 px-4 transition-transform duration-700 ease-out-expo group-hover/card:scale-[1.03]">
                            {menuApps.map((a) => (
                              <AppIcon src={a.icon} size={36} ring={false} />
                            ))}
                          </div>
                        )}
                        {group.featured.visual === "code" && <PostCover seed="build-menu" />}
                      </div>
                      <div class="flex items-start justify-between gap-3 p-4">
                        <span>
                          <span class="block text-[0.9375rem] font-medium text-fg">
                            {group.featured.title}
                          </span>
                          <span class="mt-0.5 block text-sm leading-snug text-faint">
                            {group.featured.description}
                          </span>
                        </span>
                        <Icon
                          name={
                            group.featured.href.startsWith("http")
                              ? "ph:arrow-up-right"
                              : "ph:arrow-right"
                          }
                          class="mt-0.5 size-4 shrink-0 text-faint transition-colors group-hover/card:text-fg"
                          aria-hidden="true"
                        />
                      </div>
                    </a>
                  </div>
                </div>
              </li>
            );
          })}
          {navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                {...linkAttrs(link)}
                aria-current={isActive(link.href) ? "page" : undefined}
                class="inline-flex h-9 items-center rounded-pill px-3.5 text-sm text-muted transition-colors hover:text-fg aria-[current=page]:text-fg"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="ml-auto flex items-center gap-2">
        <a
          href={headerActions.secondary.href}
          {...linkAttrs(headerActions.secondary)}
          class="hidden h-10 items-center rounded-pill px-4 text-sm font-medium text-fg transition-colors hover:bg-surface-2 md:inline-flex"
        >
          {headerActions.secondary.label}
        </a>
        <Button href={headerActions.primary.href} size="md" class="max-sm:hidden!">
          {headerActions.primary.label}
        </Button>
        <button
          type="button"
          class="inline-flex size-10 items-center justify-center rounded-pill border border-line-strong text-fg lg:hidden"
          aria-expanded="false"
          aria-controls="mobile-menu"
          data-mobile-toggle
        >
          <span class="sr-only" data-mobile-label>
            Open menu
          </span>
          <Icon name="ph:list" class="size-5" aria-hidden="true" data-icon-open />
          <Icon name="ph:x" class="hidden size-5" aria-hidden="true" data-icon-close />
        </button>
      </div>
    </div>

    <!-- Mobile menu -->
    <div
      id="mobile-menu"
      class="hidden max-h-[calc(100dvh-4rem)] overflow-y-auto border-t border-line lg:hidden"
      data-mobile-menu
    >
      <nav aria-label="Mobile" class="space-y-7 px-5 py-6">
        {navGroups.map((group) => {
          const items = [
            { label: group.featured.title, href: group.featured.href },
            ...group.links,
          ].filter((l, i, all) => all.findIndex((o) => o.href === l.href) === i);
          return (
            <div>
              <p class="font-mono text-xs text-faint">{group.label}</p>
              <ul class="mt-2">
                {items.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      {...ext(link.href)}
                      aria-current={isActive(link.href) ? "page" : undefined}
                      class="flex items-center justify-between py-2.5 text-lg text-fg aria-[current=page]:text-accent-300"
                    >
                      {link.label}
                      <Icon
                        name={link.href.startsWith("http") ? "ph:arrow-up-right" : "ph:arrow-right"}
                        class="size-4 text-faint"
                        aria-hidden="true"
                      />
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          );
        })}
        <ul class="border-t border-line pt-5">
          {navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isActive(link.href) ? "page" : undefined}
                class="flex items-center justify-between py-2.5 text-lg text-fg aria-[current=page]:text-accent-300"
              >
                {link.label}
                <Icon name="ph:arrow-right" class="size-4 text-faint" aria-hidden="true" />
              </a>
            </li>
          ))}
        </ul>
        <div class="grid gap-2 sm:grid-cols-2">
          <Button href={headerActions.secondary.href} size="lg" variant="secondary" class="w-full">
            {headerActions.secondary.label}
          </Button>
          <Button href={headerActions.primary.href} size="lg" class="w-full">
            {headerActions.primary.label}
          </Button>
        </div>
      </nav>
    </div>
  </div>
</header>

<style>
  /*
   * Opening from closed: the backdrop grows from 0 and the content fades in.
   * Moving between dropdowns: the old content slides out and the new one slides in from the
   * side it is on (--menu-shift, set by the script), while the backdrop changes height.
   */
  .menu-panel {
    visibility: hidden;
    opacity: 0;
    transform: translateX(var(--menu-shift, 0px));
    transition:
      opacity 0.22s ease,
      transform 0.45s cubic-bezier(0.16, 1, 0.3, 1),
      visibility 0s linear 0.22s;
  }
  .menu-panel[data-open] {
    visibility: visible;
    opacity: 1;
    transform: none;
    transition:
      opacity 0.3s ease 0.05s,
      transform 0.45s cubic-bezier(0.16, 1, 0.3, 1),
      visibility 0s;
  }
  .menu-backdrop {
    height: 0;
    opacity: 0;
    transition:
      height 0.45s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.2s ease 0.1s;
  }
  .menu-backdrop[data-open] {
    opacity: 1;
    transition:
      height 0.45s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.15s ease;
  }
  .menu-scrim {
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .menu-scrim[data-open] {
    opacity: 1;
  }
</style>

<script>
  // ---- Desktop mega menu ----
  const header = document.querySelector<HTMLElement>("[data-header]");
  const bar = document.querySelector<HTMLElement>("[data-header-bar]");
  const scrim = document.querySelector<HTMLElement>("[data-menu-scrim]");
  const items = [...document.querySelectorAll<HTMLElement>("[data-menu-item]")];
  const canHover = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
  let closeTimer = 0;

  const backdrop = document.querySelector<HTMLElement>("[data-menu-backdrop]");
  const panelOf = (it: HTMLElement) => it.querySelector<HTMLElement>("[data-menu-panel]")!;
  const openItem = () => items.find((it) => panelOf(it).hasAttribute("data-open"));
  const SHIFT = 56; // px the content slides when moving between dropdowns

  const setOpen = (item: HTMLElement | null) => {
    const prev = openItem();
    if (prev === item) return;
    const dir = prev && item ? Math.sign(items.indexOf(item) - items.indexOf(prev)) : 0;

    if (prev) {
      // Leave towards the opposite side of where the new dropdown is.
      panelOf(prev).style.setProperty("--menu-shift", `${-dir * SHIFT}px`);
      panelOf(prev).removeAttribute("data-open");
      prev.querySelector("[data-menu-trigger]")?.setAttribute("aria-expanded", "false");
    }
    if (item) {
      const panel = panelOf(item);
      // Start on the side the dropdown comes from, without animating to that start position.
      panel.style.transition = "none";
      panel.style.setProperty("--menu-shift", `${dir * SHIFT}px`);
      void panel.offsetWidth;
      panel.style.transition = "";
      panel.setAttribute("data-open", "");
      item.querySelector("[data-menu-trigger]")?.setAttribute("aria-expanded", "true");
      if (backdrop) backdrop.style.height = `${panel.offsetHeight}px`;
    } else if (backdrop) {
      backdrop.style.height = "0px";
    }
    backdrop?.toggleAttribute("data-open", !!item);
    bar?.toggleAttribute("data-open", !!item);
    scrim?.toggleAttribute("data-open", !!item);
  };

  for (const item of items) {
    const trigger = item.querySelector<HTMLButtonElement>("[data-menu-trigger]")!;
    trigger.addEventListener("click", () => setOpen(openItem() === item ? null : item));
    if (canHover) {
      item.addEventListener("pointerenter", () => {
        clearTimeout(closeTimer);
        setOpen(item);
      });
      item.addEventListener("pointerleave", () => {
        closeTimer = window.setTimeout(() => setOpen(null), 180);
      });
    }
  }

  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    const it = openItem();
    if (it) {
      setOpen(null);
      it.querySelector<HTMLElement>("[data-menu-trigger]")?.focus();
    }
    if (mobileOpen) setMobile(false);
  });
  document.addEventListener("click", (e) => {
    if (!header?.contains(e.target as Node)) setOpen(null);
  });
  header?.addEventListener("focusout", (e) => {
    const next = e.relatedTarget as Node | null;
    const it = openItem();
    if (it && next && !it.contains(next)) setOpen(null);
  });

  // ---- Bar background and line only once the page is scrolled ----
  const sentinel = document.querySelector("[data-top-sentinel]");
  if (sentinel && bar) {
    new IntersectionObserver(([entry]) =>
      bar.toggleAttribute("data-scrolled", !entry.isIntersecting),
    ).observe(sentinel);
  }

  // ---- Mobile menu ----
  const toggle = document.querySelector<HTMLButtonElement>("[data-mobile-toggle]");
  const menu = document.querySelector<HTMLElement>("[data-mobile-menu]");
  let mobileOpen = false;
  const setMobile = (open: boolean) => {
    mobileOpen = open;
    toggle?.setAttribute("aria-expanded", String(open));
    menu?.classList.toggle("hidden", !open);
    toggle?.querySelector("[data-icon-open]")?.classList.toggle("hidden", open);
    toggle?.querySelector("[data-icon-close]")?.classList.toggle("hidden", !open);
    const label = toggle?.querySelector("[data-mobile-label]");
    if (label) label.textContent = open ? "Close menu" : "Open menu";
  };
  toggle?.addEventListener("click", () => setMobile(!mobileOpen));
</script>
