---
/**
 * Step switcher: a numbered list on the left (the active item expands with its text and a
 * link, and a hairline above it fills in brand orange while it is shown), and a large visual
 * on a dot-grid stage on the right. It moves to the next item on its own; hovering or
 * focusing the block pauses it, and so does the pause button next to the title. With reduced
 * motion it never advances. Without JS every item is expanded.
 *
 * Visuals are named slots, one per item: <Fragment slot="visual-0">…</Fragment>.
 */
import { Icon } from "astro-icon/components";
import Button from "../ui/Button.astro";

export interface TabItem {
  title: string;
  body: string;
  cta?: { label: string; href: string };
}

interface Props {
  id: string;
  title?: string;
  items: TabItem[];
  /** Seconds per item when advancing on its own. */
  interval?: number;
}
const { id, title, items, interval = 8 } = Astro.props;

const visuals = await Promise.all(
  items.map((_, i) =>
    Astro.slots.has(`visual-${i}`) ? Astro.slots.render(`visual-${i}`) : Promise.resolve(""),
  ),
);
const num = (i: number) => String(i + 1).padStart(2, "0");
---

<div
  class="grid items-center gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.2fr)] lg:gap-16"
  style={`--tab-duration:${interval}s`}
  data-tabs
>
  <div class="min-w-0">
    <div class="flex items-end justify-between gap-6">
      {title && <h2 class="type-h2 text-fg" set:html={title} />}
      <button
        type="button"
        class="inline-flex size-9 shrink-0 items-center justify-center rounded-pill border border-line text-muted transition-colors hover:border-line-strong hover:text-fg"
        aria-pressed="false"
        data-tab-pause
        hidden
      >
        <Icon name="ph:pause-fill" class="size-3.5" aria-hidden="true" data-icon-pause />
        <Icon name="ph:play-fill" class="hidden size-3.5" aria-hidden="true" data-icon-play />
        <span class="sr-only" data-pause-label>
          Pause
        </span>
      </button>
    </div>

    <ul class:list={["border-b border-line", title && "mt-10 md:mt-12"]}>
      {items.map((item, i) => (
        <li class="tab relative" data-tab data-active={i === 0 || undefined}>
          <span class="absolute inset-x-0 top-0 h-px overflow-hidden bg-line" aria-hidden="true">
            <span class="tab-fill absolute inset-0 origin-left bg-accent" />
          </span>
          <h3>
            <button
              type="button"
              id={`${id}-tab-${i}`}
              aria-controls={`${id}-panel-${i}`}
              aria-expanded={i === 0 ? "true" : "false"}
              class="group/t flex w-full items-baseline gap-4 py-5 text-left text-xl tracking-tight text-faint transition-colors duration-300 hover:text-muted aria-expanded:text-fg md:text-2xl"
              data-tab-trigger
            >
              <span class="tabular w-6 shrink-0 font-mono text-xs text-faint transition-colors group-aria-expanded/t:text-accent-300">
                {num(i)}
              </span>
              {item.title}
            </button>
          </h3>
          <div
            id={`${id}-panel-${i}`}
            role="region"
            aria-labelledby={`${id}-tab-${i}`}
            class="tab-body"
            data-tab-body
          >
            <div class="min-h-0 overflow-hidden">
              <div class="pb-7 pl-10">
                <p class="max-w-[50ch] leading-relaxed text-muted">{item.body}</p>
                {item.cta && (
                  <Button href={item.cta.href} variant="ghost" class="mt-5 text-sm">
                    {item.cta.label}
                  </Button>
                )}
                <!-- Small screens: the visual sits under the active item -->
                {visuals[i] && (
                  <div class="tab-stage mt-8 -ml-10 lg:hidden" aria-hidden="true">
                    <div class="grid place-items-center px-4 py-8 sm:px-8" set:html={visuals[i]} />
                  </div>
                )}
              </div>
            </div>
          </div>
        </li>
      ))}
    </ul>
  </div>

  <!-- Large screens: one stage, visuals cross-fade -->
  <div class="tab-stage relative hidden aspect-[5/4] lg:block" aria-hidden="true">
    {visuals.map((v, i) => (
      <div class:list={["tab-visual", i === 0 && "is-active"]} data-tab-visual set:html={v} />
    ))}
  </div>
</div>

<style>
  /* Collapsible bodies: expanded without JS, collapsed (except the active one) with JS. */
  .tab-body {
    display: grid;
    grid-template-rows: 1fr;
    transition: grid-template-rows 0.55s var(--ease-out-expo);
  }
  :global(.js) .tab:not([data-active]) .tab-body {
    grid-template-rows: 0fr;
  }

  /* Stage: the site's dot grid with a single warm light. */
  .tab-stage {
    overflow: hidden;
    border-radius: 1rem;
    background:
      radial-gradient(55% 65% at 85% 100%, rgb(255 57 18 / 0.32), transparent 70%),
      radial-gradient(circle at center, rgb(255 255 255 / 0.11) 1px, transparent 1.4px) 0 0 / 18px
        18px,
      var(--color-surface);
    box-shadow: inset 0 0 0 1px var(--color-line);
  }
  .tab-visual {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 7%;
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 0.5s ease,
      transform 0.8s var(--ease-out-expo);
  }
  .tab-visual.is-active {
    opacity: 1;
    transform: none;
  }

  /* Progress: the active item's hairline fills over --tab-duration. */
  .tab-fill {
    transform: scaleX(0);
  }
  .tab[data-active] .tab-fill {
    animation: tab-fill var(--tab-duration) linear forwards;
  }
  [data-tabs][data-paused] .tab[data-active] .tab-fill {
    animation-play-state: paused;
  }
  [data-tabs][data-still] .tab[data-active] .tab-fill {
    animation: none;
    transform: none;
  }
  @keyframes tab-fill {
    to {
      transform: scaleX(1);
    }
  }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>("[data-tabs]")) {
    const tabs = [...root.querySelectorAll<HTMLElement>("[data-tab]")];
    const visuals = [...root.querySelectorAll<HTMLElement>("[data-tab-visual]")];
    const pause = root.querySelector<HTMLButtonElement>("[data-tab-pause]")!;
    pause.hidden = false;

    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let current = 0;
    let userPaused = reduced;
    let hovered = false;
    let offscreen = true;

    const sync = () => {
      root.toggleAttribute("data-paused", userPaused || hovered || offscreen);
      root.toggleAttribute("data-still", userPaused);
      pause.setAttribute("aria-pressed", String(userPaused));
      pause.querySelector("[data-icon-pause]")?.classList.toggle("hidden", userPaused);
      pause.querySelector("[data-icon-play]")?.classList.toggle("hidden", !userPaused);
      const label = pause.querySelector("[data-pause-label]");
      if (label) label.textContent = userPaused ? "Play" : "Pause";
    };

    const show = (i: number) => {
      current = (i + tabs.length) % tabs.length;
      tabs.forEach((t, j) => {
        const on = j === current;
        // Re-adding data-active restarts the fill animation on the new item.
        t.removeAttribute("data-active");
        if (on) {
          void t.offsetWidth;
          t.setAttribute("data-active", "");
        }
        t.querySelector("[data-tab-trigger]")?.setAttribute("aria-expanded", String(on));
        const body = t.querySelector<HTMLElement>("[data-tab-body]");
        if (body) body.inert = !on;
      });
      visuals.forEach((v, j) => v.classList.toggle("is-active", j === current));
    };

    tabs.forEach((t, i) => {
      t.querySelector("[data-tab-trigger]")?.addEventListener("click", () => show(i));
      t.querySelector(".tab-fill")?.addEventListener("animationend", () => show(current + 1));
    });
    pause.addEventListener("click", () => {
      userPaused = !userPaused;
      sync();
    });
    root.addEventListener("pointerenter", () => ((hovered = true), sync()));
    root.addEventListener("pointerleave", () => ((hovered = false), sync()));
    root.addEventListener("focusin", () => ((hovered = true), sync()));
    root.addEventListener("focusout", (e) => {
      if (!root.contains(e.relatedTarget as Node)) ((hovered = false), sync());
    });
    new IntersectionObserver(([entry]) => {
      offscreen = !entry.isIntersecting;
      sync();
    }).observe(root);

    show(0);
    sync();
  }
</script>
