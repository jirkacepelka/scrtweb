---
/**
 * An ecosystem app icon as a rounded square tile (iOS-style corner ratio).
 * Icons are pre-normalised to opaque 256px squares by scripts/sync-ecosystem.mjs.
 */
interface Props {
  src: string;
  /** Empty when the app name is printed next to the icon. */
  alt?: string;
  /** Rendered size in px. */
  size?: number;
  /** Hairline ring to separate dark icons from dark cards. Off where icons float freely. */
  ring?: boolean;
  class?: string;
  style?: string;
  eager?: boolean;
}
const {
  src,
  alt = "",
  size = 56,
  ring = true,
  class: className,
  style = "",
  eager = false,
} = Astro.props;
---

<img
  src={src}
  alt={alt}
  width={size}
  height={size}
  loading={eager ? "eager" : "lazy"}
  decoding="async"
  class:list={["block shrink-0 rounded-[22%]", ring && "ring-1 ring-white/10", className]}
  style={`width:${size}px;height:${size}px;${style}`}
/>
