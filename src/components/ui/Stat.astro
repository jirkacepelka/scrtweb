---
/** A single figure: big value, label, optional note. */
interface Props {
  value: string;
  label: string;
  note?: string;
}
const { value, label, note } = Astro.props;
---

<div data-reveal>
  <dt class="text-sm text-muted">{label}</dt>
  <dd class="type-h2 tabular mt-3 whitespace-nowrap text-fg">{value}</dd>
  {note && <dd class="mt-1 font-mono text-xs text-faint">{note}</dd>}
</div>
