---
/**
 * Root HTML document. Every page goes through this (directly or via PageLayout / PostLayout).
 * Adds <head>, header, footer, and the scroll-reveal observer for [data-reveal] elements.
 */
import "../styles/global.css";
import Seo, { type SeoProps } from "../components/layout/Seo.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";

type Props = SeoProps;
const seo = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#050505" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="Secret Network blog" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Seo {...seo} />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body class="flex flex-col">
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />

    <script>
      // Reveal [data-reveal] elements once as they enter the viewport.
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add("is-visible");
            io.unobserve(entry.target);
          }
        },
        { rootMargin: "0px 0px -8% 0px" },
      );
      document.querySelectorAll<HTMLElement>("[data-reveal]").forEach((el) => io.observe(el));
    </script>
  </body>
</html>
