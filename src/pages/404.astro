---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/ui/Button.astro";
import Logo from "../components/ui/Logo.astro";
---

<BaseLayout title="Page not found" noindex>
  <section class="container-page flex min-h-[70dvh] flex-col items-start justify-center py-24">
    <Logo variant="symbol" decorative class="size-14 text-accent" />
    <p class="mt-10 font-mono text-sm text-faint">404</p>
    <h1 class="type-h1 mt-3">This page is a secret, even to us.</h1>
    <p class="mt-5 max-w-[48ch] text-lg text-muted">
      The link may be old or mistyped. Most of what you need starts from the homepage.
    </p>
    <div class="mt-9 flex flex-wrap gap-3">
      <Button href="/" size="lg">
        Go to homepage
      </Button>
      <Button href="/blog" size="lg" variant="secondary">
        Read the blog
      </Button>
    </div>
  </section>
</BaseLayout>
