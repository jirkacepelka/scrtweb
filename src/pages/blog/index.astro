---
import PageLayout from "../../layouts/PageLayout.astro";
import BlogIndex from "../../components/sections/BlogIndex.astro";
import { getPosts, getTags } from "../../lib/content";

const posts = await getPosts();
const tags = getTags(posts);
---

<PageLayout
  title="Blog"
  intro="News from Secret Network, plus plain-language guides to wallets, staking and privacy."
  description="News, announcements and guides from Secret Network."
>
  <BlogIndex posts={posts} tags={tags} />
</PageLayout>
