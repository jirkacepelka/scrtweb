---
import { Icon } from "astro-icon/components";
import PageLayout from "../layouts/PageLayout.astro";
import Section from "../components/ui/Section.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import Button from "../components/ui/Button.astro";
import CtaBand from "../components/sections/CtaBand.astro";
import { logoFiles, brandColours, brandRules } from "../data/about";
import { links } from "../config/site";
---

<PageLayout
  title="Brand assets"
  intro="Logos, colours and type for writing about Secret Network. Use them as they are, and keep the logo easy to read."
  description="Secret Network brand assets: logo downloads in SVG and PNG, brand colours, typography and usage guidelines."
>
  <Fragment slot="actions">
    <Button href="#logos" size="lg">
      Download logos
    </Button>
    <Button href={links.mediaPack} size="lg" variant="secondary">
      Full media pack
    </Button>
  </Fragment>

  <Section id="logos">
    <SectionHeading
      title="Logo"
      intro="The wordmark is the default. Use the symbol alone where space is tight, such as avatars and app icons."
      class="mb-12 md:mb-16"
    />
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {logoFiles.map((logo, i) => (
        <figure
          class="overflow-hidden rounded-xl border border-line bg-surface"
          data-reveal
          style={`--reveal-i:${i}`}
        >
          <div
            class:list={[
              "grid h-44 place-items-center border-b border-line",
              logo.preview === "light" ? "bg-fg" : "bg-ink",
            ]}
          >
            <img
              src={`/brand/${logo.file}.svg`}
              alt={logo.name}
              class:list={[logo.file.includes("symbol") ? "h-14" : "h-12", "w-auto"]}
              loading="lazy"
            />
          </div>
          <figcaption class="flex items-center justify-between gap-4 px-5 py-4">
            <span class="text-sm font-medium text-fg">{logo.name}</span>
            <span class="flex gap-2">
              {["svg", "png"].map((ext) => (
                <a
                  href={`/brand/${logo.file}.${ext}`}
                  download
                  class="inline-flex h-8 items-center gap-1.5 rounded-pill border border-line-strong px-3 font-mono text-xs text-muted uppercase transition-colors hover:border-fg/40 hover:text-fg"
                >
                  <Icon name="ph:download-simple" class="size-3.5" aria-hidden="true" />
                  {ext}
                  <span class="sr-only">download {logo.name}</span>
                </a>
              ))}
            </span>
          </figcaption>
        </figure>
      ))}
    </div>
  </Section>

  <Section class="border-t border-line">
    <SectionHeading
      title="Colours"
      intro="Mostly black and white, with Secret Orange used sparingly for what matters most."
      class="mb-12 md:mb-16"
    />
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
      {brandColours.map((c, i) => (
        <li data-reveal style={`--reveal-i:${i}`}>
          <button
            type="button"
            class="group block w-full overflow-hidden rounded-xl border border-line bg-surface text-left transition-colors hover:border-line-strong"
            data-copy={c.hex}
          >
            <span
              class="block h-28 border-b border-line"
              style={`background:${c.hex}`}
              aria-hidden="true"
            />
            <span class="block px-4 py-3.5">
              <span class="block text-sm font-medium text-fg">{c.name}</span>
              <span class="mt-1 flex items-center justify-between font-mono text-xs text-muted">
                <span data-copy-label>{c.hex}</span>
                <Icon
                  name="ph:copy"
                  class="size-3.5 text-faint group-hover:text-fg"
                  aria-hidden="true"
                />
              </span>
              <span class="mt-2 block text-xs text-faint">{c.use}</span>
            </span>
            <span class="sr-only">Copy {c.hex}</span>
          </button>
        </li>
      ))}
    </ul>
  </Section>

  <Section class="border-t border-line">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)] lg:gap-20">
      <SectionHeading
        title="Typography"
        intro="Geist for text and headings, Geist Mono for numbers and labels. Both are free and open source."
      />
      <div class="grid gap-4 sm:grid-cols-2" data-reveal>
        <a
          href="https://vercel.com/font"
          target="_blank"
          rel="noopener noreferrer"
          class="group rounded-xl border border-line bg-surface p-6 transition-colors hover:border-line-strong"
        >
          <p class="text-6xl tracking-tight text-fg">Aa</p>
          <p class="mt-8 font-medium text-fg">Geist</p>
          <p class="mt-1 text-sm text-muted">Headings and text</p>
        </a>
        <a
          href="https://vercel.com/font"
          target="_blank"
          rel="noopener noreferrer"
          class="group rounded-xl border border-line bg-surface p-6 transition-colors hover:border-line-strong"
        >
          <p class="font-mono text-6xl tracking-tight text-fg">01</p>
          <p class="mt-8 font-medium text-fg">Geist Mono</p>
          <p class="mt-1 text-sm text-muted">Figures and labels</p>
        </a>
      </div>
    </div>
  </Section>

  <Section class="border-t border-line">
    <SectionHeading title="Using the logo" class="mb-12 md:mb-16" />
    <div class="grid gap-4 md:grid-cols-2">
      {[
        { title: "Do", items: brandRules.do, icon: "ph:check", tone: "text-accent-300" },
        { title: "Don't", items: brandRules.dont, icon: "ph:x", tone: "text-faint" },
      ].map((col, i) => (
        <div
          class="rounded-xl border border-line bg-surface p-7"
          data-reveal
          style={`--reveal-i:${i}`}
        >
          <h3 class="font-medium text-fg">{col.title}</h3>
          <ul class="mt-5 space-y-3">
            {col.items.map((item) => (
              <li class="flex gap-3 text-muted">
                <Icon
                  name={col.icon}
                  class:list={["mt-0.5 size-5 shrink-0", col.tone]}
                  aria-hidden="true"
                />
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </Section>

  <CtaBand
    title="Need more?"
    body="The full media pack has every logo variant and the complete guidelines."
    primary={{ label: "Full media pack", href: links.mediaPack }}
    secondary={{ label: "Secret Foundation", href: "/foundation" }}
  />
</PageLayout>

<script>
  for (const btn of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
    btn.addEventListener("click", async () => {
      const label = btn.querySelector("[data-copy-label]");
      try {
        await navigator.clipboard.writeText(btn.dataset.copy!);
        if (label) {
          label.textContent = "Copied";
          setTimeout(() => (label.textContent = btn.dataset.copy!), 1400);
        }
      } catch {
        // Clipboard blocked: the hex code is visible anyway.
      }
    });
  }
</script>
