---
/**
 * Homepage: a simple hub. Hero, a "Get started" switcher for the four first steps, one row of
 * doors into the rest of the site, and the latest news. Detail lives on the inner pages.
 */
import { Icon } from "astro-icon/components";
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/ui/Section.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import Button from "../components/ui/Button.astro";
import Card from "../components/ui/Card.astro";
import BrowserFrame from "../components/ui/BrowserFrame.astro";
import ShowcaseCard from "../components/ui/ShowcaseCard.astro";
import Hero from "../components/sections/Hero.astro";
import TabShowcase, { type TabItem } from "../components/sections/TabShowcase.astro";
import PostCard from "../components/sections/PostCard.astro";
import { partners } from "../data/partners";
import { apps, heroApps } from "../data/ecosystem";
import { wallets } from "../data/wallets";
import { acquirePaths } from "../data/get-scrt";
import { getPosts, getRoadmap } from "../lib/content";
import dashboardStaking from "../assets/screens/dashboard-staking.png";

const posts = (await getPosts()).slice(0, 3);
const roadmap = await getRoadmap();

const start: TabItem[] = [
  {
    title: "Get a wallet",
    body: "Install Keplr or Leap in a minute. Your wallet holds your SCRT, signs transactions and connects you to apps. Only you hold the keys.",
    cta: { label: "Choose a wallet", href: "/wallets" },
  },
  {
    title: "Get SCRT",
    body: "Buy on an exchange, pay with a card or swap tokens you already own. Then send it to your wallet.",
    cta: { label: "Ways to get SCRT", href: "/scrt#get-scrt" },
  },
  {
    title: "Stake and earn",
    body: "Delegate to a validator on the Secret Dashboard. You help secure the network, earn rewards and get a vote in governance.",
    cta: { label: "How staking works", href: "/staking" },
  },
  {
    title: "Use private apps",
    body: `Swap, message, store and compute in apps where your data stays encrypted. Browse ${apps.length} apps from the official registry.`,
    cta: { label: "Explore Ecosystem", href: "/ecosystem" },
  },
];

const walletRows = wallets.map((w) => ({
  logo: w.logo,
  onLight: w.logoOnLight,
  label: w.name,
  meta: w.platforms.join(" · "),
  tag: w.recommended ? "Recommended" : undefined,
}));

const venueRows = acquirePaths.flatMap((p) =>
  p.venues
    .filter((v) => v.logo)
    .map((v) => ({ logo: v.logo!, onLight: v.logoOnLight, label: v.name, meta: p.title })),
);

const doors = [
  {
    title: "Ecosystem",
    body: "Private DeFi, wallets, AI and tools built on Secret.",
    href: "/ecosystem",
    icon: "ph:squares-four",
  },
  {
    title: "Secret 2.0",
    body: "Confidential machines and Secret Money. What changes, and when.",
    href: "/secret-2",
    icon: "ph:cpu",
  },
  {
    title: "Builders",
    body: "Docs, SDKs, grants and a chat with core developers.",
    href: "/builders",
    icon: "ph:code",
  },
  {
    title: "Community",
    body: "Join the chat, the forum and on-chain governance.",
    href: "/community",
    icon: "ph:users-three",
  },
];
---

<BaseLayout>
  <Hero
    title="Privacy for everyone.<br /><em>Start with SCRT.</em>"
    subtitle="Secret Network keeps your data encrypted, even while apps use it. Get, stake and use SCRT in minutes."
    primary={{ label: "Get SCRT", href: "/scrt#get-scrt" }}
    secondary={{ label: "Explore Ecosystem", href: "/ecosystem" }}
    apps={heroApps}
    partners={partners}
  />

  <Section>
    <TabShowcase id="start" title="Get started" items={start}>
      <Fragment slot="visual-0">
        <ShowcaseCard title="Wallets" aside="Secret supported" rows={walletRows} />
      </Fragment>
      <Fragment slot="visual-1">
        <ShowcaseCard title="Get SCRT" aside="Pick a route" rows={venueRows} />
      </Fragment>
      <Fragment slot="visual-2">
        <BrowserFrame
          src={dashboardStaking}
          alt=""
          url="dash.scrt.network"
          class="w-full max-w-xl shadow-[0_40px_100px_-30px_rgb(0_0_0/0.9)]!"
        />
      </Fragment>
      <Fragment slot="visual-3">
        <ShowcaseCard
          title="Ecosystem"
          aside={`${apps.length} apps`}
          icons={heroApps.slice(0, 15).map((a) => a.icon)}
        />
      </Fragment>
    </TabShowcase>
  </Section>

  <Section class="border-t border-line">
    <SectionHeading title="Explore Secret" class="mb-10 md:mb-14" />
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {doors.map((d, i) => (
        <Card href={d.href} class="flex flex-col p-6!" style={`--reveal-i:${i}`}>
          <span class="inline-flex size-10 items-center justify-center rounded-lg border border-line-strong bg-ink text-fg">
            <Icon name={d.icon} class="size-5" aria-hidden="true" />
          </span>
          <h3 class="type-h3 mt-10 text-fg">{d.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">{d.body}</p>
          <Icon
            name="ph:arrow-right"
            class="absolute top-6 right-6 size-5 text-faint transition-all group-hover:translate-x-0.5 group-hover:text-fg"
            aria-hidden="true"
          />
        </Card>
      ))}
    </div>
  </Section>

  <Section class="border-t border-line">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)] lg:gap-16">
      {posts.length > 0 && (
        <div>
          <div class="mb-8 flex items-end justify-between gap-6">
            <SectionHeading title="Latest" />
            <Button href="/blog" variant="ghost">
              Blog
            </Button>
          </div>
          <div class="grid gap-3">
            {posts.map((post, i) => (
              <PostCard post={post} variant="row" index={i} />
            ))}
          </div>
        </div>
      )}

      <a
        href="/roadmap"
        class="group flex flex-col rounded-xl border border-line bg-surface p-7 transition-colors hover:border-line-strong lg:mt-[4.5rem]"
        data-reveal
      >
        <p class="text-sm text-muted">Roadmap · Secret 2.0</p>
        <p class="tabular mt-3 text-6xl tracking-tight text-fg">~{roadmap.overall}%</p>
        <div class="mt-4 h-px w-full bg-line" aria-hidden="true">
          <div class="h-px bg-accent" style={`width:${roadmap.overall}%`} />
        </div>
        <ul class="mt-6 space-y-2.5 text-sm">
          {roadmap.tracks.map((t) => (
            <li class="flex justify-between gap-4">
              <span class="text-muted">{t.name}</span>
              <span class="tabular text-fg">~{t.readiness}%</span>
            </li>
          ))}
        </ul>
        <span class="mt-auto inline-flex items-center gap-2 pt-8 text-sm font-medium text-fg group-hover:text-accent-300">
          Roadmap
          <Icon name="ph:arrow-right" class="size-4" aria-hidden="true" />
        </span>
      </a>
    </div>
  </Section>
</BaseLayout>
