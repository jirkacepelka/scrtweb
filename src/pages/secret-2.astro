---
import { Icon } from "astro-icon/components";
import PageLayout from "../layouts/PageLayout.astro";
import Section from "../components/ui/Section.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import Button from "../components/ui/Button.astro";
import Badge from "../components/ui/Badge.astro";
import ArchDiagram from "../components/ui/ArchDiagram.astro";
import TabShowcase from "../components/sections/TabShowcase.astro";
import CtaBand from "../components/sections/CtaBand.astro";
import { draftNotice, parts, impact, limits } from "../data/secret2";
import { links } from "../config/site";
import { getRoadmap } from "../lib/content";

const roadmap = await getRoadmap();
const rollout = roadmap.tracks.find((t) => t.id === "networks")?.items ?? [];
---

<PageLayout
  title="Secret 2.0"
  intro="Secret is moving from contracts that run on validators to confidential programs on dedicated machines, with Secret Money for private balances."
  description="Secret 2.0: confidential virtual machines, Secret Money and encrypted storage. What changes for SCRT holders, private token holders and builders."
>
  <Fragment slot="actions">
    <Button href={links.whitepaper} size="lg">
      Read the whitepaper
    </Button>
    <Button href="/roadmap" size="lg" variant="secondary">
      Roadmap
    </Button>
  </Fragment>

  <Section spacing="md">
    <div
      class="flex flex-col gap-3 rounded-xl border border-line bg-surface px-5 py-4 sm:flex-row sm:items-center sm:gap-4"
      data-reveal
    >
      <Badge tone="soon">Draft</Badge>
      <p class="text-sm leading-relaxed text-muted">{draftNotice}</p>
    </div>
  </Section>

  <Section spacing="md" class="pt-0!">
    <TabShowcase id="how" title="How it works" items={parts} interval={10}>
      {parts.map((p, i) => (
        <Fragment slot={`visual-${i}`}>
          <ArchDiagram highlight={p.layer} />
        </Fragment>
      ))}
    </TabShowcase>
  </Section>

  <Section class="border-t border-line">
    <SectionHeading title="What it means for you" class="mb-12 md:mb-16" />
    <div class="grid gap-px overflow-hidden rounded-xl border border-line bg-line md:grid-cols-3">
      {impact.map((item, i) => (
        <div class="bg-ink p-7 md:p-8" data-reveal style={`--reveal-i:${i}`}>
          <Icon name={item.icon} class="size-6 text-accent-300" aria-hidden="true" />
          <h3 class="type-h3 mt-8 text-fg">{item.who}</h3>
          <p class="mt-3 leading-relaxed text-muted">{item.body}</p>
        </div>
      ))}
    </div>
  </Section>

  <Section class="border-t border-line">
    <div class="grid gap-14 lg:grid-cols-2 lg:gap-20">
      <div>
        <SectionHeading
          title="Rollout"
          intro="One network at a time. Each step has to prove the upgrade before the next one takes it."
          class="mb-10"
        />
        <ol class="divide-y divide-line border-y border-line">
          {rollout.map((n, i) => (
            <li
              class="grid grid-cols-[2.5rem_1fr_auto] items-center gap-4 py-5"
              data-reveal
              style={`--reveal-i:${i}`}
            >
              <span class="tabular font-mono text-sm text-faint">
                {String(i + 1).padStart(2, "0")}
              </span>
              <div>
                <p class="font-medium text-fg">{n.data.title}</p>
                <div class="mt-2 h-px w-full max-w-56 bg-line" aria-hidden="true">
                  <div class="h-px bg-accent" style={`width:${n.data.readiness ?? 0}%`} />
                </div>
              </div>
              <span class="tabular text-sm text-muted">
                {n.data.readiness !== undefined ? `~${n.data.readiness}%` : "n/a"}
              </span>
            </li>
          ))}
        </ol>
        <p class="mt-4 text-xs text-faint">Code readiness estimates, not dates.</p>
      </div>

      <div>
        <SectionHeading
          title="Known limits"
          intro="Privacy on Secret 2.0 rests on confidential computing hardware. The design states where that stops."
          class="mb-10"
        />
        <ul class="space-y-4">
          {limits.map((l, i) => (
            <li class="flex gap-3 leading-relaxed text-muted" data-reveal style={`--reveal-i:${i}`}>
              <Icon
                name="ph:warning-circle"
                class="mt-0.5 size-5 shrink-0 text-faint"
                aria-hidden="true"
              />
              {l}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </Section>

  <CtaBand
    title="Building on Secret today? <em>Plan your move early.</em>"
    body="Talk to the core developers about moving a contract to a confidential program, and ask about grants."
    primary={{ label: "Grants", href: "/grants" }}
    secondary={{ label: "Builders", href: "/builders" }}
  />
</PageLayout>
